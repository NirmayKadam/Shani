# AlphaStreams V2 Environment Configuration Template
# Copy this file to .env and replace placeholder values.

# Application
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Server / Ingestion Auth
INTERNAL_API_KEY=your-internal-api-key-here

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Database (PostgreSQL / TimescaleDB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/NexusQuantDB
DB_USER=postgres
DB_PASSWORD=postgres

# Market Data Provider (groww or nse)
MARKET_DATA_PROVIDER=nse
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=
GROWW_TOTP_SECRET=
GROWW_PIN=

# Supabase (Auth / Client)
supabaseUrl=https://your-project.supabase.co
supabaseKey=your-supabase-anon-publishable-key
supabaseConnectionString=
# Only for legacy HS256 projects; leave blank to verify tokens with the project's JWKS
SUPABASE_JWT_SECRET=

# Alert delivery
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_ALLOW_PRIVATE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@alphastreams.io
SMTP_USE_TLS=true

# WebSocket admission limits
WS_MAX_CONNECTIONS=1000
WS_MAX_SYMBOLS=50

# Ingestion Settings
WATCHLIST_SYMBOLS=NIFTY,BANKNIFTY,FINNIFTY,RELIANCE,TCS,INFY,HDFCBANK
PRICE_POLL_INTERVAL_SECONDS=5
OPTIONS_POLL_INTERVAL_SECONDS=15

# Pricing subscriber process pool size (blank = CPU count - 1)
PRICING_WORKERS=

# Macro Defaults
DEFAULT_RISK_FREE_RATE_INR=6.5
DEFAULT_RISK_FREE_RATE_USD=5.25
