# AlphaStreams V2 — Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.template .env

# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────
# Redis / Postgres (used by app + workers)
# ──────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/NexusQuantDB

# Docker-compose postgres service credentials
DB_USER=postgres
DB_PASSWORD=postgres

# ──────────────────────────────────────────────────────────────
# Market Watchlist + Polling Intervals (seconds)
# ──────────────────────────────────────────────────────────────
PRICE_POLL_INTERVAL_SECONDS=5
OPTIONS_POLL_INTERVAL_SECONDS=15

# ──────────────────────────────────────────────────────────────
# Stream Consumer Tuning
# ──────────────────────────────────────────────────────────────
INGESTION_REFRESH_COOLDOWN=30

# ──────────────────────────────────────────────────────────────
# Market Data Provider Config (nse | groww)
# ──────────────────────────────────────────────────────────────
MARKET_DATA_PROVIDER=nse
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=
