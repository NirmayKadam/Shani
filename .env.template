# AlphaStreams V2 — Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.template .env

# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────
# Redis / Postgres (used by app + workers)
# ──────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/NexusQuantDB

# Docker-compose postgres service credentials
DB_USER=postgres
DB_PASSWORD=postgres

# ──────────────────────────────────────────────────────────────
# External APIs
# ──────────────────────────────────────────────────────────────
# Required for headline ingestion (https://newsapi.org/ — free tier works).
# Leave empty to disable news fetching gracefully.
NEWS_API_KEY=

# ──────────────────────────────────────────────────────────────
# Model Config
# ──────────────────────────────────────────────────────────────
MODEL_CACHE_DIR=./models
FINBERT_MODEL=ProsusAI/finbert

# ──────────────────────────────────────────────────────────────
# Market Watchlist + Polling Intervals (seconds)
# ──────────────────────────────────────────────────────────────
NEWS_POLL_INTERVAL_SECONDS=90
PRICE_POLL_INTERVAL_SECONDS=5
OPTIONS_POLL_INTERVAL_SECONDS=15

# ──────────────────────────────────────────────────────────────
# Stream Consumer Tuning
# ──────────────────────────────────────────────────────────────
SENTIMENT_CONSUMER_NAME=sentiment-worker-1
SENTIMENT_RETRY_IDLE_MS=10000
READ_MODEL_CONSUMER_NAME=read-model-updater-1
READ_MODEL_RETRY_IDLE_MS=10000
INGESTION_REFRESH_COOLDOWN=30

# ──────────────────────────────────────────────────────────────
# Market Data Provider Config (nse | groww)
# ──────────────────────────────────────────────────────────────
MARKET_DATA_PROVIDER=nse
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

