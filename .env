# .env — never commit this to git

# Application
APP_ENV=development
API_KEY=your-secret-api-key-here
LOG_LEVEL=INFO

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_DB=1    # Separate Redis DB for Celery broker

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AlphaStreamsDB
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/AlphaStreamsDB
# External APIs
# Zerodha KiteConnect (optional, for real-time ticks)
KITE_API_KEY=
KITE_API_SECRET=
# NewsAPI.org
NEWS_API_KEY=2500a06088bd424582857cd672fb1373
# Alpha Vantage (generous free tier)
ALPHA_VANTAGE_KEY=
REDDIT_CLIENT_ID=       # Reddit API credentials
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AlphaStreamsBot/1.0
TELEGRAM_API_ID=        # Telegram MTProto
TELEGRAM_API_HASH=

# NLP Models
MODEL_CACHE_DIR=./models    # Local model cache (HuggingFace downloads here)
FINBERT_MODEL=ProsusAI/finbert
SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6

# Ingestion Settings
WATCHLIST_SYMBOLS=NIFTY,BANKNIFTY,RELIANCE,INFY,HDFCBANK,TCS,ICICIBANK
NEWS_POLL_INTERVAL_SECONDS=120
TICK_POLL_INTERVAL_SECONDS=60


